NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://usuario:senha@localhost:5432/adm_taxi
APP_ORIGINS=http://localhost:8100,http://localhost:4200
JWT_ACCESS_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=gere-outro-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=2592000
LOG_LEVEL=info
TRUST_PROXY=false
# Opcional. Habilita o endpoint protegido de provisionamento de empresas.
# PROVISIONING_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Bootstrap do primeiro administrador da plataforma. Armazene somente hash Argon2id.
# MASTER_BOOTSTRAP_USERNAME=master
# MASTER_BOOTSTRAP_PASSWORD_HASH=$argon2id$...

# Apenas para `npm run seed:dev` em PostgreSQL local.
# SEED_DEMO_CONFIRM=CRIAR_DADOS_DEMO
# SEED_DEMO_PASSWORD=defina-uma-senha-forte
