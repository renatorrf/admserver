{
  "name": "adm-taxi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do sistema corporativo ADM Taxi",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "gcp-build": "npm run build",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:configure": "node scripts/configure-local-env.mjs",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:validate": "tsx src/db/migrate.ts validate",
    "migrate:status": "tsx src/db/migrate.ts status",
    "migrate:down": "tsx src/db/migrate.ts down",
    "db:inspect": "tsx src/db/inspect-schema.ts",
    "db:cleanup-keep-gestors": "node scripts/cleanup-keep-gestors.mjs",
    "db:restore-default-center": "node scripts/restore-default-cost-center.mjs",
    "seed:dev": "tsx src/db/seed-development.ts",
    "master:configure": "node scripts/configure-master-bootstrap.mjs",
    "master:bootstrap": "tsx src/db/bootstrap-master.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
